# Public PaiNaiDee backend API
VITE_API_BASE_URL="https://painaidee-api-production.up.railway.app"

# Public Supabase client configuration (safe to expose in the browser)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Preferred key format for new Supabase projects:
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key-here"
# Legacy fallback only. Do not use a service_role/secret key here.
# VITE_SUPABASE_ANON_KEY="your-legacy-anon-key-here"

# Server-only Supabase configuration. NEVER prefix these with VITE_.
SUPABASE_URL="https://your-project-id.supabase.co"
# Preferred server key format:
SUPABASE_SECRET_KEY="sb_secret_your-key-here"
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-service-role-key-here"

# Admin bootstrap script. Use a strong unique password and do not commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# API security
CORS_ALLOWED_ORIGINS="https://pai-naidee-ui-spark.vercel.app"
PORT=8000

# Optional: Enable debug features in the app
# VITE_ENABLE_DEBUG=true

# Railway backend database (server only; injected by Railway service reference)
# DATABASE_URL="${{Postgres.DATABASE_URL}}"
